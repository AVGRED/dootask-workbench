# 复制为 .env 后按需修改；docker compose 会自动读取同目录 .env

# MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=workbench
MYSQL_USER=workbench
MYSQL_PASSWORD=workbench
MYSQL_PORT=3306

# 后端
SERVER_PORT=9000
JWT_SECRET=please-change-me-to-a-random-32-byte-secret

# 前端三端端口
STAFF_PORT=8080
ADMIN_PORT=8081
MOBILE_PORT=8082
