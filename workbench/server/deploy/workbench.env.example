# 工作台后端环境配置（复制为 workbench.env 后按需修改）
# 复制命令：Copy-Item workbench.env.example workbench.env

# 必填：JWT 签名密钥，至少 32 字符随机串
# 生成：openssl rand -base64 48   （或 PowerShell: [Convert]::ToBase64String((1..48|%{Get-Random -Max 256}))）
JWT_SECRET=请替换成至少32字符的随机串

# 数据库
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/workbench?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=wb
SPRING_DATASOURCE_PASSWORD=wb

# 服务端口
SERVER_PORT=9020

# 上传文件目录（务必纳入备份）
STORAGE_ROOT=D:/repos/workbench/dootask/workbench/server/data/uploads

# 邮件（可选，不填则邮件功能自动降级为只记日志）
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@workbench.local
WORKBENCH_BASE_URL=http://localhost:5180
